{
  "name": "realtime-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server",
    "test": "npm run test -w shared && npm run test -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^5.0.0"
  }
}
